# drama-studio 环境配置（火山服务器 /etc/drama-studio.env）
# 占位值：登录与云端 API 暂不可用，页面/反代可正常验证
PORT=18080
DRAMA_DB_PATH=/opt/drama-studio/data/drama-studio.db

# JWT 签名密钥（占位，上线前替换为随机长串）
JWT_SECRET=PLACEHOLDER_REPLACE_WITH_RANDOM_64_CHARS

# ai-connect OAuth（占位）
AI_CONNECT_CLIENT_SECRET=PLACEHOLDER
AI_CONNECT_REDIRECT_URI=http://14.103.23.160/drama-studio/api/v1/auth/callback
FRONTEND_URL=http://14.103.23.160/drama-studio

# 阿里云 OSS（占位）
OSS_ACCESS_KEY_ID=PLACEHOLDER
OSS_ACCESS_KEY_SECRET=PLACEHOLDER
OSS_BUCKET=PLACEHOLDER
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
